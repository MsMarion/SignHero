# ==========================================
# MASTER SWITCH: local | cloud
# ==========================================
STORAGE_MODE="local"

# ==========================================
# DATABASE SETTINGS (MongoDB)
# ==========================================
# Local Docker MongoDB
DATABASE_URL="mongodb://localhost:4002/signhero?directConnection=true"

# Cloud MongoDB Atlas Example
# DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/ASL?retryWrites=true&w=majority"

# ==========================================
# STORAGE SETTINGS (Local MinIO vs Cloud S3)
# ==========================================
# Local MinIO Credentials
LOCAL_STORAGE_KEY="admin"
LOCAL_STORAGE_SECRET="password"
LOCAL_STORAGE_ENDPOINT="localhost:4003"
LOCAL_STORAGE_BUCKET="signhero"

# Cloud S3/Spaces Credentials
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_ENDPOINT=""
DO_SPACES_BUCKET=""
DO_SPACES_REGION="nyc3"

# ==========================================
# AI SERVICES & PYTHON BRIDGE
# ==========================================
GEMINI_API_KEY=""
GEMINI_MODEL_ID="gemini-2.5-flash"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
PYTHON_PATH="python"

# ==========================================
# FRONTEND / NEXT.JS CONFIG
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_GOOGLE_API_KEY=""
NEXT_PUBLIC_API_URL="http://localhost:4001"
NEXT_PUBLIC_WS_URL="ws://localhost:4001/ws/predict"

# NextAuth
NEXTAUTH_SECRET="secret-uuid-or-hash"
NEXTAUTH_URL="http://localhost:4000"

# Google sign-in (optional; the button only appears when both are set).
# In Google Cloud Console create an OAuth 2.0 Web client with
#   authorised origins:   http://localhost:4000  and your public site origin
#   redirect URIs:        <origin>/api/auth/callback/google  (same two origins)
# NEXTAUTH_URL above must match the origin you are browsing.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Detection tickets: any random string of 16+ characters (e.g. `openssl rand -hex 32`). The detection server
# needs the same value as DETECTION_TOKEN_SECRET; leave both unset for local development.
# DETECTION_TOKEN_SECRET=
