// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

// ADD MODELS HERE
model Song {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  songName      String
  isCommunity   Boolean
  albumName     String?
  thumbnailName String?
  thumbnailUrl  String?
  audioUrl      String?
  interactions  Interaction[]
  scores        LeaderboardEntry[]
  createdAt     DateTime      @default(now())
  v             Int           @default(0) @map("__v")
}

model LeaderboardEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  score     Int
  accuracy  Float    @default(0)
  songId    String?  @db.ObjectId
  song      Song?    @relation(fields: [songId], references: [id])
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  playerId  String?  @db.ObjectId
  createdAt DateTime @default(now())
  v         Int      @default(0) @map("__v")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  // Not unique: accounts are identified by email, and a unique index on an optional field makes
  // MongoDB reject every second user that has no name (null collides with null).
  name          String?
  displayName   String?   // The name shown on scorecards
  email         String?   @unique
  password      String?   // Hashed password
  geminiApiKey  String?   // User's custom Gemini API key
  image         String?
  scores        LeaderboardEntry[]
  heroName      HeroName?
  createdAt     DateTime  @default(now())
}

// A hero name an account has claimed. Permanent: there is no rename path in the app.
// Kept in its own collection (not as a unique optional field on User) because MongoDB treats a
// missing field as null in a unique index, which would block every user that has not chosen yet.
model HeroName {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique // normalised form used for uniqueness, see src/server/hero-name.ts
  name      String   // as the player typed it (case and spacing kept for display)
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Player {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  score               Int
  avgReactionTime     Float
  mistakesMade        Int
  correctHits         Int
  commonMistakes      CommonMistake[]
  createdAt           DateTime        @default(now())
  v                   Int             @default(0) @map("__v")
  // Set when the game starts; the server checks the finished result against them (see score-validation.ts).
  userId              String?         @db.ObjectId
  ipKey               String?
  finalizedAt         DateTime?
  // A game that used tap-to-score on a phone: kept for the player's report, never put on the leaderboard.
  practice            Boolean?
}

type Interaction {
  key         String
  timeElapsed Float
}

type CommonMistake {
  key1  String  // Letter they showed
  key2  String  // Letter that was expected
  hits  Int     // Number of times this mistake occurred
}