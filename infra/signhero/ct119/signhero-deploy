#!/usr/bin/env bash
# Whitelisted deploy verbs for the SignHero FRONTEND on CT119 (Next.js app, MongoDB, MinIO).
# Installed root-owned as /usr/local/bin/signhero-deploy. The CI deploy key is forced to run
# signhero-deploy-entry, which validates the request and calls this via: sudo signhero-deploy <verb>
#
# Verbs:
#   status           show the deployed commit, build folder, service state and health (read-only)
#   backup           dump the MongoDB database to /var/backups/signhero
#   deploy <sha>     release commit <sha>, which must be on origin/main:
#                      back up Mongo, fast-forward the repo, install, BUILD ASIDE into .next-<sha>
#                      while the current release keeps serving, apply the schema (additive only),
#                      then switch by restarting with the new build folder and health-check.
#                      Any failure after the repo changes rolls back automatically and still exits
#                      non-zero, so a failed deploy is never reported as a success.
#   rollback         return to the previous release (previous commit and build folder)
#
# The database is NOT restored by rollback. Schema changes must be additive; restoring a dump from
# /var/backups/signhero is a manual step on purpose.
set -euo pipefail

REPO=/opt/signhero
APP=$REPO/asl
SERVICE=signhero-frontend
STATE=/var/lib/signhero-deploy
BACKUPS=/var/backups/signhero
DISTENV=/etc/signhero/dist.env
KEEP_BACKUPS=10
HEALTH_SECONDS=60
BUILD_HEAP_MB=2048
MIN_AVAILABLE_MB=1800
# Only for manual testing as root (sudo from the CI key resets the environment, so CI cannot set it):
HEALTH_PATH="${SIGNHERO_TEST_HEALTH_PATH:-/whack}"

verb="${1:-}"
arg="${2:-}"

log() { echo "[$(date +%H:%M:%S)] $*"; }
git_repo() { git -C "$REPO" "$@"; }
cur_sha() { git_repo rev-parse HEAD; }
cur_dist() { local d; d=$(grep -s '^NEXT_DIST_DIR=' "$DISTENV" | tail -1 | cut -d= -f2- || true); echo "${d:-.next}"; }
set_dist() { printf 'NEXT_DIST_DIR=%s\n' "$1" > "$DISTENV.tmp" && mv "$DISTENV.tmp" "$DISTENV"; }
# Next rewrites the tracked tsconfig.json when distDir is not .next; put it back so the tree stays clean.
restore_generated() { git_repo checkout -- asl/tsconfig.json 2>/dev/null || true; }

health_once() {
  systemctl is-active --quiet "$SERVICE" \
    && curl -fsS -m 8 -o /dev/null "http://127.0.0.1:4000${HEALTH_PATH}" \
    && curl -fsS -m 8 -o /dev/null "http://127.0.0.1:4000/api/auth/providers" \
    && [ "$(docker exec asl-mongodb mongosh --quiet --eval 'db.adminCommand("ping").ok' 2>/dev/null | tr -d '\r\n')" = "1" ]
}

health() {
  local deadline=$((SECONDS + HEALTH_SECONDS))
  log "waiting for the site to be healthy (up to ${HEALTH_SECONDS}s)"
  until health_once; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "FAIL: health check did not pass within ${HEALTH_SECONDS}s" >&2
      return 1
    fi
    sleep 3
  done
  log "health: ok"
}

show_status() {
  echo "== frontend (CT119) =="
  echo "commit:   $(git_repo log --format='%h %s' -1 | cut -c1-90)  (branch $(git_repo branch --show-current))"
  echo "build:    $(cur_dist)"
  echo "service:  $(systemctl is-active "$SERVICE" 2>/dev/null || true)"
  echo "previous: $(cut -c1-7 "$STATE/prev-sha" 2>/dev/null || echo none) / $(cat "$STATE/prev-dist" 2>/dev/null || echo none)"
  # shellcheck disable=SC2012 # the dump names are generated by this script (timestamp and sha only)
  echo "backup:   $(ls -1t "$BACKUPS" 2>/dev/null | head -1 || true)"
  if health_once; then echo "health:   ok"; else echo "health:   FAILING"; fi
}

backup_db() {
  mkdir -p "$BACKUPS"
  local out
  out="$BACKUPS/signhero-$(date +%Y%m%d-%H%M%S)-$(cur_sha | cut -c1-7).archive.gz"
  log "backing up MongoDB to $out"
  docker exec asl-mongodb mongodump --quiet --archive --gzip --db signhero > "$out.tmp" || { rm -f "$out.tmp"; return 1; }
  mv "$out.tmp" "$out"
  # keep only the newest KEEP_BACKUPS dumps
  # shellcheck disable=SC2012 # the dump names are generated by this script (timestamp and sha only)
  ls -1t "$BACKUPS"/signhero-*.archive.gz 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | xargs -r rm -f
}

prune_dists() {
  local keep1="$1" keep2="$2" d b
  for d in "$APP"/.next "$APP"/.next-*; do
    [ -d "$d" ] || continue
    b=$(basename "$d")
    if [ "$b" != "$keep1" ] && [ "$b" != "$keep2" ]; then log "removing old build folder $b"; rm -rf "$d"; fi
  done
}

restart_service() { systemctl restart "$SERVICE"; }

# Everything after the repo has changed: one guarded chain, so a failure at ANY step (install, build,
# schema, restart or health) falls through to rollback, not just a health-check failure.
deploy_chain() {
  local sha="$1" short="${1:0:12}" dist
  dist=".next-$short"
  git_repo merge --ff-only --quiet "$sha" || return 1
  log "repo at: $(git_repo log --format='%h %s' -1 | cut -c1-90)"

  log "installing dependencies (also regenerates the Prisma client)"
  (cd "$APP" && pnpm install --frozen-lockfile --silent) || return 1

  log "building into $dist while the current release keeps serving"
  rm -rf "${APP:?}/${dist:?}"
  (cd "$APP" && NEXT_DIST_DIR="$dist" NODE_OPTIONS="--max-old-space-size=$BUILD_HEAP_MB" nice -n 10 pnpm build > /tmp/signhero-build.log 2>&1) \
    || { echo "build failed; last lines:" >&2; tail -15 /tmp/signhero-build.log >&2; restore_generated; return 1; }
  restore_generated

  log "applying the database schema (additive changes only; no --accept-data-loss)"
  (cd "$APP" && pnpm exec prisma db push --skip-generate > /tmp/signhero-dbpush.log 2>&1) \
    || { echo "prisma db push failed; last lines:" >&2; tail -10 /tmp/signhero-dbpush.log >&2; return 1; }

  log "switching to $dist (restarting the service)"
  set_dist "$dist"
  restart_service || return 1
  health
}

rollback_to() {
  local sha="$1" dist="$2"
  log "rolling back to ${sha:0:7} (build folder $dist)"
  restore_generated
  if [ ! -d "$APP/$dist" ]; then
    echo "the previous build folder $dist is gone, so it cannot be restored automatically" >&2
    return 1
  fi
  git_repo reset --hard --quiet "$sha" || return 1
  (cd "$APP" && pnpm install --frozen-lockfile --silent) || log "warning: install during rollback failed; continuing"
  set_dist "$dist"
  restart_service || return 1
  health
}

preflight_deploy() {
  local sha="$1"
  if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then echo "abort: deploy needs a full 40-character commit sha" >&2; return 3; fi
  restore_generated
  if [ "$(git_repo branch --show-current)" != "main" ]; then echo "abort: $REPO is not on main" >&2; return 3; fi
  if [ -n "$(git_repo status --porcelain --untracked-files=no)" ]; then echo "abort: tracked files are modified in $REPO" >&2; return 3; fi
  timeout 90 git -C "$REPO" fetch --quiet origin main || { echo "abort: could not fetch origin main" >&2; return 3; }
  git_repo cat-file -e "$sha^{commit}" 2>/dev/null || { echo "abort: commit $sha is not in the repository" >&2; return 3; }
  if ! git_repo merge-base --is-ancestor "$sha" origin/main; then
    echo "abort: $sha is not on origin/main, refusing to deploy it" >&2
    return 3
  fi
  local avail
  avail=$(awk '/MemAvailable/ {printf "%d", $2/1024}' /proc/meminfo)
  if [ "$avail" -lt "$MIN_AVAILABLE_MB" ]; then
    echo "abort: only ${avail} MB of memory available, the build needs about ${MIN_AVAILABLE_MB} MB" >&2
    return 3
  fi
}

run_deploy() {
  local sha="$1" prev prev_dist
  preflight_deploy "$sha" || return $?
  prev=$(cur_sha); prev_dist=$(cur_dist)

  if [ "$prev" = "$sha" ]; then
    if health_once; then log "already at ${sha:0:7} and healthy; nothing to do"; return 0; fi
    log "already at ${sha:0:7} but not healthy; restarting the service"
    restart_service && health && return 0
    echo "FAILED: still unhealthy. No code changed in this run, so there is nothing to roll back to." >&2
    return 1
  fi

  # Remember what to return to BEFORE anything changes, so the rollback verb works after any failure.
  printf '%s\n' "$prev" > "$STATE/prev-sha"; printf '%s\n' "$prev_dist" > "$STATE/prev-dist"

  backup_db || { echo "abort: the database backup failed, nothing was changed" >&2; return 3; }

  if deploy_chain "$sha"; then
    prune_dists ".next-${sha:0:12}" "$prev_dist"
    return 0
  fi

  echo "DEPLOY FAILED (commit ${sha:0:7})" >&2
  if rollback_to "$prev" "$prev_dist"; then
    echo "rollback OK: service restored on ${prev:0:7}" >&2
  else
    echo "ROLLBACK ALSO FAILED -- manual intervention needed (previous build folder and database dump are still on disk)" >&2
  fi
  return 1
}

run_rollback() {
  local prev prev_dist
  prev=$(cat "$STATE/prev-sha" 2>/dev/null || true); prev_dist=$(cat "$STATE/prev-dist" 2>/dev/null || true)
  if [[ ! "$prev" =~ ^[0-9a-f]{40}$ ]] || [ -z "$prev_dist" ]; then
    echo "abort: no previous release is recorded, nothing to roll back to" >&2
    return 3
  fi
  rollback_to "$prev" "$prev_dist"
}

case "$verb" in
  status) show_status; exit 0 ;;
  backup|rollback|deploy) ;;
  *) echo "unknown verb '$verb'. Allowed: status backup rollback deploy <sha>" >&2; exit 2 ;;
esac

mkdir -p "$STATE" "$BACKUPS" "$(dirname "$DISTENV")"
exec 9>/var/lock/signhero-deploy.lock
if ! flock -n 9; then
  echo "another deploy is running; try again shortly" >&2
  exit 4
fi

start=$SECONDS
rc=0
case "$verb" in
  backup)   backup_db || rc=1 ;;
  rollback) run_rollback || rc=$? ;;
  deploy)   run_deploy "$arg" || rc=$? ;;
esac
show_status
if [ "$rc" -eq 0 ]; then
  echo "done: $verb in $((SECONDS - start))s"
else
  echo "FAILED: $verb in $((SECONDS - start))s (exit $rc, see the log above)" >&2
fi
exit "$rc"
