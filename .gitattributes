# Scripts that run on Linux hosts must keep LF line endings even when checked out on Windows
# (a CR after the #! line makes the script fail with "bad interpreter").
infra/signhero/** text eol=lf
*.sh text eol=lf

# Media and model files are binary: never convert their line endings.
*.mp3 binary
*.webm binary
*.pth binary
*.png binary
*.jpg binary
*.ico binary
